# PostgreSQL Database Connection
DATABASE_URL="postgresql://vendorchain_user:vendorchain_password@localhost:5432/vendorchain_db?schema=public"

# Redis Connection for BullMQ Asynchronous Verification Pipeline (Required in production)
REDIS_URL="redis://localhost:6379"

# Verification Adapter: "sandbox" (Deterministic Sandbox) | "gstn" (Govt GSTN Portal Stub)
VERIFICATION_ADAPTER="sandbox"

# Storage Driver: "local" (Encrypted local disk volume) | "s3" (S3 / MinIO object storage)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage/encrypted_docs"

# S3 Storage Configuration (When STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="vendorchain-encrypted-documents"
S3_ACCESS_KEY_ID="minio_admin"
S3_SECRET_ACCESS_KEY="minio_password_sec_local"
S3_FORCE_PATH_STYLE="true"

# Master Key Encryption Key (KEK) - 32 bytes (64 hex characters) for AES-256-GCM Envelope Encryption
KEK_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Actor Attribution Key Mapping (JSON name:key map for audit log attribution)
ADMIN_KEYS='{"ops-lead":"vc_admin_ops_key_32bytes_sample","compliance":"vc_admin_audit_key_32bytes_sam"}'

# Default Fallback Admin API Key (Matched to actor 'admin:default')
ADMIN_API_KEY="vc_admin_sec_placeholder_key_32bytes_min"

# Build SHA identifier for /api/health endpoint
BUILD_SHA="dev-local-sha"
