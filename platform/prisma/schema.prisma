datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VendorStatus {
  UNVERIFIED
  PENDING
  IN_PROGRESS
  VERIFIED
  FAILED
  FLAGGED
  BLOCKED
}

enum DocumentType {
  GST_CERT
  PAN_CARD
  BANK_PROOF
}

enum DocumentStatus {
  STORED
  PENDING
  VERIFIED
  REJECTED
  FLAGGED
}

enum TrustTier {
  TIER_1_CRITICAL
  TIER_2_STANDARD
  TIER_3_RESTRICTED
  TIER_4_SUSPENDED
}

model Vendor {
  id           String              @id @default(cuid())
  legalName    String
  gstNumber    String              @unique
  panEncrypted String              // Encrypted AES-256-GCM payload (NO plaintext PAN column exists)
  status       VendorStatus        @default(UNVERIFIED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  documents    Document[]
  events       VerificationEvent[]
  trustScores  TrustScoreSnapshot[]

  @@index([gstNumber])
  @@index([status])
}

// Append-only, time-series snapshot of a vendor's continuously computed
// behavioral trust score (0-100). Persisted on every evaluation so the GET
// endpoint can surface the latest snapshot and a 30-day historical trend.
// No update or delete operations are permitted on this table.
model TrustScoreSnapshot {
  id                String       @id @default(cuid())
  vendorId          String
  vendor            Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  compositeScore    Int          // 0-100
  tier              TrustTier
  identityScore     Int          // 0-100, weight 35%
  supplyChainScore  Int          // 0-100, weight 45%
  behaviorScore     Int          // 0-100, weight 20%
  penaltyDeduction  Int          // aggregated anomaly/audit deductions
  reasons           String       // JSON array of human-readable contributing factors
  calculatedAt      DateTime     @default(now())

  @@index([vendorId])
  @@index([calculatedAt])
}

model Document {
  id          String         @id @default(cuid())
  vendorId    String
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  type        DocumentType
  storagePath String
  sha256      String
  dekWrapped  String         // DEK encrypted by Master KEK (hex/base64)
  iv          String         // Initialization vector for document encryption (hex)
  authTag     String         // AES-256-GCM authentication tag (hex)
  status      DocumentStatus @default(STORED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([vendorId])
  @@index([sha256])
}

// Append-only immutable verification audit trail.
// No update or delete operations are permitted on this table.
model VerificationEvent {
  id         String       @id @default(cuid())
  vendorId   String
  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  actor      String       // Identity or subsystem initiating the event
  fromStatus VendorStatus
  toStatus   VendorStatus
  reason     String
  createdAt  DateTime     @default(now())

  @@index([vendorId])
  @@index([createdAt])
}
